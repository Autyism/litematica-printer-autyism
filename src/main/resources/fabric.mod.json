{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "A standalone printer for Litematica: builds the loaded schematic around you, bottom layer first. Places redstone, rails and doors the right way, pauses while you use containers, waits for the server where it matters, restocks from shulker boxes, switches tools and drives bedrock-breaking mods. Based on the BiliXWhite and water2004 Litematica Printer forks.",
  "authors": [
    "Autyism"
  ],
  "contact": {
    "homepage": "https://github.com/Autyism/litematica-printer-autyism",
    "sources": "https://github.com/Autyism/litematica-printer-autyism",
    "issues": "https://github.com/Autyism/litematica-printer-autyism/issues"
  },
  "license": "AGPL-3.0-only",
  "icon": "assets/litematica-printer-autyism/icon.png",
  "contributors": [
    "aleksilassila",
    "zhaixianyu",
    "BlinkWhite",
    "bunnyi116",
    "water2004"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.autyism.printer.LitematicaPrinterMod"
    ],
    "modmenu": [
      "com.autyism.printer.compat.ModMenuCompat"
    ]
  },
  "mixins": [
    "litematica-printer-autyism.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*",
    "malilib": ">=0.27.0",
    "litematica": ">=0.26.0"
  },
  "suggests": {
    "shulkerbox": "*",
    "quickshulker": "*",
    "bedrockminer": "*",
    "bedrock-miner": "*",
    "autyism-le": "*"
  },
  "breaks": {
    "litematica-printer": "*",
    "litematica_printer": "*"
  }
}
