{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "icon": "assets/litematica-printer-autyism/icon.png",
  "description": "Litematica Printer Autyism Edition: a standalone printer for Litematica based on the BiliXWhite / water2004 Litematica Printer forks, with container-safe printing, layered printing for huge ranges, bedrock mode for multiple bedrock miners, smart shulker restock (Advanced Shulkerboxes / QuickShulker) and built-in tool switching.",
  "authors": [
    "Autyism"
  ],
  "contributors": [
    "aleksilassila",
    "zhaixianyu",
    "BlinkWhite",
    "bunnyi116",
    "water2004"
  ],
  "license": "AGPL-3.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.autyism.printer.LitematicaPrinterMod"
    ],
    "modmenu": [
      "com.autyism.printer.compat.ModMenuCompat"
    ]
  },
  "mixins": [
    "litematica-printer-autyism.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*",
    "malilib": ">=0.27.0",
    "litematica": ">=0.26.0"
  },
  "suggests": {
    "shulkerbox": "*",
    "quickshulker": "*",
    "bedrockminer": "*",
    "bedrock-miner": "*",
    "autyism-le": "*"
  },
  "breaks": {
    "litematica-printer": "*"
  }
}